# Environment Variables — Trello OS
DATABASE_URL=postgresql://trello:trello_dev_123@localhost:5432/trello_os
DB_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret-DO-NOT-USE-IN-PRODUCTION
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WS_AUTH_REQUIRED=true
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
REBALANCE_SCAN_MS=60000
NODE_ENV=development


# ── Storage (Cloudflare R2 in production, MinIO in dev) ──────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=trello-os-attachments
R2_PUBLIC_URL=https://pub-xxx.r2.dev
# Dev override (MinIO — must match docker-compose.yml):
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_MAX_ATTACHMENT_SIZE_MB=25
