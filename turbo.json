{
  "tasks": {
    "test": {
      "dependsOn": ["^test"],
      "cache": true,
      "env": ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "NODE_ENV"]
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "cache": true,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
